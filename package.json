{
  "name": "spa-one-file",
  "version": "0.1.0",
  "type": "module",
  "description": "A single, standalone version of Preact, HTM and Preact Signals. No external dependencies, just one single file.",
  "files": ["dist/*"],
  "module": "dist/standalone.js",
  "umd:main": "dist/standalone.umd.js",
  "main": "dist/standalone.umd.js",
  "scripts": {
    "postversion": "git push && git push --tags && npm publish",
    "prepublishOnly": "npm run bundle",
    "bundle": "microbundle index.js -o ./dist/standalone.js -f es,umd --no-sourcemap --target web"
  },
  "dependencies": {
    "@preact/signals": "^1.2.2",
    "htm": "3.1.1",
    "microbundle": "^0.15.1",
    "preact": "^10.19.3"
  },
  "devDependencies": {
  },
  "keywords": [
    "preact signals",
    "signals",
    "standalone",
    "cdn",
    "preact",
    "react",
    "ui",
    "user interface",
    "virtual dom",
    "vdom",
    "components",
    "dom diff",
    "front-end",
    "framework",
    "Hyperscript Tagged Markup",
    "tagged template",
    "template literals",
    "html",
    "htm",
    "jsx",
    "virtual dom",
    "hyperscript"
  ],
  "homepage": "https://github.com/nichoth/preact-htm-signals-standalone",
  "bugs": {
    "url": "https://github.com/nichoth/preact-htm-signals-standalone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nichoth/preact-htm-signals-standalone.git"
  },
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)",
  "license": "MIT"
}
